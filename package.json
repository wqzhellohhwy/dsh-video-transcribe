{
  "name": "dsh-video-transcribe",
  "version": "0.2.0",
  "description": "DeepSeek Harness 插件:贴一个视频链接,用本机工具链下载音轨并离线转写为文稿(yt-dlp + ffmpeg + sherpa-onnx/SenseVoice),长音频自动分片,零云端 API。",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "segment.js",
    "selftest.mjs",
    "e2e.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check segment.js",
    "test": "node selftest.mjs",
    "e2e": "node e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "cordis",
    "transcribe",
    "asr",
    "sensevoice"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
